#!/bin/sh

PROJECT_DIR="/Users/zendu/Desktop/LCTransfer"
VENV_DIR="$PROJECT_DIR/.venv"
VENV_PY="$VENV_DIR/bin/python3"
REQUIREMENTS="$PROJECT_DIR/requirements.txt"
BREW_PREFIX="$(command -v brew >/dev/null 2>&1 && brew --prefix 2>/dev/null || echo /opt/homebrew)"
EXPAT_LIB="$BREW_PREFIX/opt/expat/lib/libexpat.1.dylib"

# ai coding: 自愈启动器——venv 失效或缺依赖时自动重建；pyexpat 与系统 libexpat 不兼容时自动重链接并重签名 2026/09/07: 16:19
die() {
    echo "lct: $1" >&2
    exit 1
}

find_python3() {
    command -v python3 >/dev/null 2>&1
}

fix_pyexpat() {
    PYX="$("$1" -c "import pyexpat; print(pyexpat.__file__)" 2>/dev/null)"
    [ -n "$PYX" ] && [ -f "$PYX" ] || return 1
    "$1" -c "import pyexpat" 2>/dev/null && return 0
    echo "lct: 修复 pyexpat 与系统 libexpat 的兼容性问题..."
    [ -f "$EXPAT_LIB" ] || brew install expat >/dev/null 2>&1 || return 1
    install_name_tool -change /usr/lib/libexpat.1.dylib "$EXPAT_LIB" "$PYX" >/dev/null 2>&1 || return 1
    codesign --force --sign - "$PYX" >/dev/null 2>&1 || return 1
    "$1" -c "import pyexpat" 2>/dev/null
}

build_venv() {
    echo "lct: 重建虚拟环境 $VENV_DIR ..."
    rm -rf "$VENV_DIR"
    if ! "$1" -m venv "$VENV_DIR" 2>/dev/null; then
        fix_pyexpat "$1" || return 1
        rm -rf "$VENV_DIR"
        "$1" -m venv "$VENV_DIR" 2>/dev/null || return 1
    fi
    "$VENV_DIR/bin/python3" -m pip install -q -r "$REQUIREMENTS" || return 1
    return 0
}

find_python3 || die "未找到 python3，请先安装 Python 3。"

if [ ! -x "$VENV_PY" ] || ! "$VENV_PY" -c "import flask, flask_cors, flask_socketio" 2>/dev/null; then
    build_venv python3 || die "虚拟环境构建失败，请手动执行: python3 -m venv $VENV_DIR && $VENV_DIR/bin/pip install -r $REQUIREMENTS"
fi

cd "$PROJECT_DIR" || die "无法进入项目目录 $PROJECT_DIR"
exec "$VENV_PY" app.py
